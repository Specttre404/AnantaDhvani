<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Glass Outer Ring -->
    <path
        android:pathData="M 54,27 A 27,27 0 1,1 53.99,27 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#35FFFFFF"
        android:fillColor="#00000000" />

    <!-- Centered Neon Cyan-to-Magenta-to-Gold Harmonic Wave -->
    <path
        android:pathData="M 24,54 C 30,54 34.5,36 42,36 C 49.5,36 52.5,72 60,72 C 67.5,72 70.5,42 78,42 C 81,42 84,54 87,54"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="36"
                android:endX="87"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00F0FF" />
                <item android:offset="0.5" android:color="#FFFF2E93" />
                <item android:offset="1.0" android:color="#FFFFC700" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing White Pulse Nodes -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 60,72 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 42,36 m -3,0 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0" />
</vector>
