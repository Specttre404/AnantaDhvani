        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="28"
                android:endX="78"
                android:endY="44"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0077B6" />
                <item android:offset="1.0" android:color="#000077B6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vibrant Acoustic Wave -->
    <path
        android:pathData="M 24,54 C 30,54 34,36 42,36 C 50,36 53,72 61,72 C 69,72 72,42 79,42 C 82,42 84,54 88,54"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="36"
                android:endX="88"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0077B6" />
                <item android:offset="0.5" android:color="#FF6A0DAD" />
                <item android:offset="1.0" android:color="#FFE63946" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pulse Node -->
    <path
        android:fillColor="#FF1A1C24"
        android:pathData="M 61,72 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />
