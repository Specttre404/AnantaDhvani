    <!-- Specular Glass Ring -->
    <path
        android:pathData="M 54,28 A 26,26 0 1,1 53.99,28 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#501A1C24"
        android:fillColor="#00000000" />

    <path
